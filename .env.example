DATABASE_URL=sqlite:///./qa_dashboard.db
CORS_ORIGINS=http://127.0.0.1:5173
AUTO_CREATE_SCHEMA=true
DATA_SOURCE=github
GITHUB_ACTIONS_INGEST_TOKEN=change-me

# Trigger GitHub Actions from dashboard (PAT: repo + workflow scope)
GITHUB_CI_TOKEN=
GITHUB_CI_REPO=mmohansqaai/SelfHealingPlaywrightFramework
GITHUB_CI_WORKFLOW_FILE=playwright.yml
GITHUB_CI_DEFAULT_REF=main
